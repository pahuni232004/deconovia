PORT=3001

# Render Postgres connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DECOR_AEROPONIC?schema=public

# Backend behavior
CORS_ORIGIN=http://localhost:3000
COOKIE_SECRET=change-me-to-a-long-random-string

# Optional admin seeding (run on first request if table is empty)
ADMIN_SEED_USERNAME_1=Pahuni
ADMIN_SEED_PASSWORD_1=wewillsucceed
ADMIN_SEED_USERNAME_2=Pavit
ADMIN_SEED_PASSWORD_2=wewillsucceed

# Twilio (OTP via SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SendGrid (OTP / email notifications)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=hello@decoraeroponic.com

# When true (and provider creds are missing), the API will return demoOtp in responses.
ALLOW_DEMO_OTP=true

